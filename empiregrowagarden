/* ---- textures procédurales (canvas), aucune ressource externe ---- */
function makeCanvasTexture(draw, w, h, rx, ry){
  const c = document.createElement('canvas'); c.width=w; c.height=h;
  draw(c.getContext('2d'), w, h);
  const tex = new THREE.CanvasTexture(c);
  tex.wrapS = tex.wrapT = THREE.RepeatWrapping;
  tex.repeat.set(rx||1, ry||1);
  return tex;
}
function makeSkyTexture(){
  const c = document.createElement('canvas'); c.width=4; c.height=256;
  const ctx = c.getContext('2d');
  const g = ctx.createLinearGradient(0,0,0,256);
  g.addColorStop(0,'#7fc3e0'); g.addColorStop(0.5,'#bfe3db'); g.addColorStop(1,'#f8ecc4');
  ctx.fillStyle = g; ctx.fillRect(0,0,4,256);
  return new THREE.CanvasTexture(c);
}
function makeGrassTexture(){
  return makeCanvasTexture((ctx,w,h)=>{
    ctx.fillStyle = '#719a52'; ctx.fillRect(0,0,w,h);
    for(let i=0;i<2200;i++){
      const x=Math.random()*w, y=Math.random()*h;
      const l = 26+Math.random()*22, hue=92+Math.random()*22;
      ctx.fillStyle = `hsl(${hue},${38+Math.random()*18}%,${l}%)`;
      ctx.fillRect(x,y,2,2+Math.random()*2);
    }
  }, 512,512, 14,14);
}
function makeSoilTexture(){
  return makeCanvasTexture((ctx,w,h)=>{
    ctx.fillStyle = '#4A3427'; ctx.fillRect(0,0,w,h);
    ctx.strokeStyle = 'rgba(0,0,0,.28)'; ctx.lineWidth = 4;
    for(let y=6;y<h;y+=13){ ctx.beginPath(); ctx.moveTo(0,y); ctx.lineTo(w,y); ctx.stroke(); }
    for(let i=0;i<220;i++){
      ctx.fillStyle = `rgba(${100+Math.random()*50},${65+Math.random()*30},${42+Math.random()*20},.55)`;
      ctx.fillRect(Math.random()*w, Math.random()*h, 2,2);
    }
  }, 128,128);
}
function makePathTexture(){
  return makeCanvasTexture((ctx,w,h)=>{
    ctx.fillStyle = '#c9b48a'; ctx.fillRect(0,0,w,h);
    for(let i=0;i<60;i++){
      ctx.fillStyle = `rgba(${140+Math.random()*40},${120+Math.random()*30},${90+Math.random()*20},.6)`;
      const x=Math.random()*w, y=Math.random()*h, s=6+Math.random()*10;
      ctx.beginPath(); ctx.ellipse(x,y,s,s*0.7,Math.random()*Math.PI,0,Math.PI*2); ctx.fill();
    }
  }, 128,128, 2,10);
}

/* ---- éléments de décor ---- */
function buildTree(scale=1){
  const g = new THREE.Group();
  const trunk = new THREE.Mesh(new THREE.CylinderGeometry(0.11,0.16,1.1,7), new THREE.MeshStandardMaterial({color:0x5c4230, roughness:1}));
  trunk.position.y = 0.55; trunk.castShadow = true;
  g.add(trunk);
  const foliageMat = new THREE.MeshStandardMaterial({color:0x4a7a3a, roughness:.9});
  for(let i=0;i<3;i++){
    const s = 0.62 - i*0.1;
    const blob = new THREE.Mesh(new THREE.IcosahedronGeometry(s,1), foliageMat);
    blob.position.set((Math.random()-0.5)*0.25, 1.15+i*0.42, (Math.random()-0.5)*0.25);
    blob.castShadow = true;
    g.add(blob);
  }
  g.scale.setScalar(scale);
  return g;
}
function buildBush(){
  const g = new THREE.Group();
  const mat = new THREE.MeshStandardMaterial({color:0x5a9146, roughness:.9});
  for(let i=0;i<3;i++){
    const b = new THREE.Mesh(new THREE.IcosahedronGeometry(0.22+Math.random()*0.08,0), mat);
    b.position.set((Math.random()-0.5)*0.3, 0.16+Math.random()*0.1, (Math.random()-0.5)*0.3);
    b.castShadow = true;
    g.add(b);
  }
  return g;
}
function buildLantern(){
  const g = new THREE.Group();
  const post = new THREE.Mesh(new THREE.CylinderGeometry(0.04,0.05,0.9,6), new THREE.MeshStandardMaterial({color:0x3c2c1e}));
  post.position.y = 0.45; post.castShadow = true;
  g.add(post);
  const globe = new THREE.Mesh(new THREE.SphereGeometry(0.09,10,8),
    new THREE.MeshBasicMaterial({color:0xffe0a0}));
  globe.position.y = 0.95;
  g.add(globe);
  const glow = new THREE.PointLight(0xffcf80, 0.6, 4);
  glow.position.y = 0.95;
  g.add(glow);
  return g;
}
function buildButterfly(color){
  const g = new THREE.Group();
  const wingMat = new THREE.MeshBasicMaterial({color, side:THREE.DoubleSide});
  const w1 = new THREE.Mesh(new THREE.CircleGeometry(0.09,8), wingMat);
  const w2 = new THREE.Mesh(new THREE.CircleGeometry(0.09,8), wingMat);
  w1.position.x = 0.07; w2.position.x = -0.07;
  g.add(w1); g.add(w2);
  g.userData.wings = [w1,w2];
  return g;
}

function initScene(){
  scene = new THREE.Scene();
  scene.background = makeSkyTexture();
  scene.fog = new THREE.Fog(0xcfe6dc, 22, 42);

  camera = new THREE.PerspectiveCamera(50, innerWidth/innerHeight, 0.1, 200);
  updateCamera();

  renderer = new THREE.WebGLRenderer({antialias:true});
  renderer.setSize(innerWidth, innerHeight);
  renderer.setPixelRatio(Math.min(devicePixelRatio,2));
  renderer.shadowMap.enabled = true;
  renderer.shadowMap.type = THREE.PCFSoftShadowMap;
  if(renderer.outputEncoding!==undefined) renderer.outputEncoding = THREE.sRGBEncoding;
  renderer.toneMapping = THREE.ACESFilmicToneMapping;
  renderer.toneMappingExposure = 1.08;
  document.getElementById('scene').appendChild(renderer.domElement);

  const hemi = new THREE.HemisphereLight(0xbfe3db, 0x4a3427, 0.95);
  scene.add(hemi);
  const sun = new THREE.DirectionalLight(0xfff3d6, 1.15);
  sun.position.set(10, 16, 8);
  sun.castShadow = true;
  sun.shadow.mapSize.set(1536,1536);
  sun.shadow.camera.left=-16; sun.shadow.camera.right=16; sun.shadow.camera.top=16; sun.shadow.camera.bottom=-16;
  sun.shadow.bias = -0.0015;
  scene.add(sun);

  // sol d'herbe texturé
  const groundGeo = new THREE.CircleGeometry(32, 56);
  const groundMat = new THREE.MeshStandardMaterial({map: makeGrassTexture(), roughness:1});
  const ground = new THREE.Mesh(groundGeo, groundMat);
  ground.rotation.x = -Math.PI/2;
  ground.receiveShadow = true;
  ground.position.y = -0.01;
  scene.add(ground);

  // allée de gravier menant à la parcelle
  const pathMat = new THREE.MeshStandardMaterial({map: makePathTexture(), roughness:1});
  const path = new THREE.Mesh(new THREE.PlaneGeometry(1.6, 8), pathMat);
  path.rotation.x = -Math.PI/2;
  path.position.set(0, 0, 9.4);
  path.receiveShadow = true;
  scene.add(path);

  // clôture en bois avec lisses horizontales
  const postMat = new THREE.MeshStandardMaterial({color:0x5c4230, roughness:1});
  const railMat = new THREE.MeshStandardMaterial({color:0x6b4a2f, roughness:1});
  const fenceR = 9.6;
  const nPosts = 28;
  for(let i=0;i<nPosts;i++){
    const a = (i/nPosts)*Math.PI*2;
    if(Math.abs(a - Math.PI*1.5) < 0.14) continue; // trouée pour l'allée
    const post = new THREE.Mesh(new THREE.CylinderGeometry(0.08,0.08,0.6,6), postMat);
    post.position.set(Math.cos(a)*fenceR, 0.3, Math.sin(a)*fenceR);
    post.castShadow = true;
    scene.add(post);
    const next = ((i+1)/nPosts)*Math.PI*2;
    if(Math.abs(next - Math.PI*1.5) < 0.2) continue;
    const mid = (a+next)/2;
    const dist = Math.hypot(Math.cos(next)*fenceR-Math.cos(a)*fenceR, Math.sin(next)*fenceR-Math.sin(a)*fenceR);
    [0.18,0.42].forEach(ry=>{
      const rail = new THREE.Mesh(new THREE.BoxGeometry(dist*1.05,0.05,0.05), railMat);
      rail.position.set(Math.cos(mid)*fenceR, ry, Math.sin(mid)*fenceR);
      rail.rotation.y = -mid + Math.PI/2;
      rail.castShadow = true;
      scene.add(rail);
    });
  }

  // ceinture décorative : arbres, buissons et lanternes
  const decoR = 12.4;
  const nDeco = 20;
  for(let i=0;i<nDeco;i++){
    const a = (i/nDeco)*Math.PI*2 + 0.15;
    if(Math.abs(((a % (Math.PI*2)) - Math.PI*1.5 + Math.PI*2) % (Math.PI*2)) < 0.3) continue; // dégager l'allée
    const x = Math.cos(a)*decoR, z = Math.sin(a)*decoR;
    const roll = i % 4;
    let deco;
    if(roll===0) deco = buildLantern();
    else if(roll===1) deco = buildTree(0.9+Math.random()*0.4);
    else deco = buildBush();
    deco.position.set(x + (Math.random()-0.5)*1.2, 0, z + (Math.random()-0.5)*1.2);
    deco.rotation.y = Math.random()*Math.PI*2;
    scene.add(deco);
  }
  // deux lanternes encadrant l'entrée de l'allée
  [-1,1].forEach(side=>{
    const lant = buildLantern();
    lant.position.set(side*1.1, 0, 8.6);
    scene.add(lant);
  });

  // petite mare décorative
  const pond = new THREE.Mesh(new THREE.CircleGeometry(1.7, 32),
    new THREE.MeshStandardMaterial({color:0x3f8fae, roughness:.15, metalness:.2, transparent:true, opacity:.88}));
  pond.rotation.x = -Math.PI/2;
  pond.position.set(-10.5, 0.01, -6.5);
  pond.receiveShadow = true;
  scene.add(pond);
  for(let i=0;i<4;i++){
    const lily = new THREE.Mesh(new THREE.CircleGeometry(0.22,10), new THREE.MeshStandardMaterial({color:0x3a8a4a}));
    lily.rotation.x = -Math.PI/2;
    const a = Math.random()*Math.PI*2, r = Math.random()*1.1;
    lily.position.set(-10.5+Math.cos(a)*r, 0.02, -6.5+Math.sin(a)*r);
    scene.add(lily);
  }

  // papillons flottants
  butterflies = [];
  [0xffffff, 0xf2c14e, 0xe8607a].forEach((c,i)=>{
    const b = buildButterfly(c);
    b.position.set(0, 2.4+i*0.3, 0);
    scene.add(b);
    butterflies.push({group:b, radius:5+i*1.4, speed:0.35+i*0.12, phase:i*2, height:2.3+i*0.35});
  });

  // garden plots grid — terre labourée avec bordure
  const total = PLOTS_SIDE*PLOTS_SIDE;
  const offset = (PLOTS_SIDE-1)*PLOT_SIZE/2;
  const soilTex = makeSoilTexture();
  const sideMat = new THREE.MeshStandardMaterial({color:0x5c4230, roughness:1});
  const bottomMat = new THREE.MeshStandardMaterial({color:0x3c2c1e, roughness:1});
  const topMat = new THREE.MeshStandardMaterial({map:soilTex, roughness:1});
  for(let i=0;i<total;i++){
    const gx = i % PLOTS_SIDE, gz = Math.floor(i/PLOTS_SIDE);
    const x = gx*PLOT_SIZE - offset, z = gz*PLOT_SIZE - offset;
    const tileGeo = new THREE.BoxGeometry(PLOT_SIZE*0.86, 0.22, PLOT_SIZE*0.86);
    const tile = new THREE.Mesh(tileGeo, [sideMat,sideMat,topMat,bottomMat,sideMat,sideMat]);
    tile.position.set(x, 0.09, z);
    tile.receiveShadow = true; tile.castShadow = true;
    tile.userData.plotIndex = i;
    scene.add(tile);
    plotMeshes.push(tile);
    state.plots[i] = state.plots[i] || null;
  }
  // cadre de bois autour de la zone cultivée
  const frameMat = new THREE.MeshStandardMaterial({color:0x6b4a2f, roughness:1});
  const gridSpan = PLOTS_SIDE*PLOT_SIZE + 0.2;
  [[0,-gridSpan/2-0.08],[0,gridSpan/2+0.08]].forEach(([dx,dz])=>{
    const beam = new THREE.Mesh(new THREE.BoxGeometry(gridSpan+0.5,0.24,0.16), frameMat);
    beam.position.set(dx,0.1,dz); beam.castShadow = true; beam.receiveShadow = true;
    scene.add(beam);
  });
  [[-gridSpan/2-0.08,0],[gridSpan/2+0.08,0]].forEach(([dx,dz])=>{
    const beam = new THREE.Mesh(new THREE.BoxGeometry(0.16,0.24,gridSpan+0.5), frameMat);
    beam.position.set(dx,0.1,dz); beam.castShadow = true; beam.receiveShadow = true;
    scene.add(beam);
  });

  clock = new THREE.Clock();
  raycaster = new THREE.Raycaster();
  mouse = new THREE.Vector2();

  window.addEventListener('resize', onResize);
  renderer.domElement.addEventListener('mousedown', onDown);
  window.addEventListener('mousemove', onMove);
  window.addEventListener('mouseup', ()=>dragging=false);
  renderer.domElement.addEventListener('wheel', onWheel, {passive:false});
  renderer.domElement.addEventListener('click', onClick);
  renderer.domElement.addEventListener('touchstart', e=>{ dragging=true; lastX=e.touches[0].clientX; lastY=e.touches[0].clientY;});
  renderer.domElement.addEventListener('touchmove', e=>{
    if(!dragging) return;
    const dx = e.touches[0].clientX-lastX, dy=e.touches[0].clientY-lastY;
    camAngle.theta -= dx*0.006; camAngle.phi = Math.max(0.35,Math.min(1.4,camAngle.phi - dy*0.006));
    lastX=e.touches[0].clientX; lastY=e.touches[0].clientY; updateCamera();
  });
  renderer.domElement.addEventListener('touchend', ()=>dragging=false);

  animate();
}

function updateCamera(){
  const {theta, phi, radius} = camAngle;
  camera.position.set(
    camTarget.x + radius*Math.sin(phi)*Math.sin(theta),
    camTarget.y + radius*Math.cos(phi),
    camTarget.z + radius*Math.sin(phi)*Math.cos(theta)
  );
  camera.lookAt(camTarget);
}
function onDown(e){ dragging=true; lastX=e.clientX; lastY=e.clientY; }
function onMove(e){
  if(!dragging) return;
  const dx = e.clientX-lastX, dy = e.clientY-lastY;
  camAngle.theta -= dx*0.006;
  camAngle.phi = Math.max(0.35, Math.min(1.4, camAngle.phi - dy*0.006));
  lastX=e.clientX; lastY=e.clientY;
  updateCamera();
}
function onWheel(e){
  e.preventDefault();
  camAngle.radius = Math.max(6, Math.min(26, camAngle.radius + e.deltaY*0.01));
  updateCamera();
}
function onResize(){
  camera.aspect = innerWidth/innerHeight; camera.updateProjectionMatrix();
  renderer.setSize(innerWidth, innerHeight);
}

/* ---- planting / harvest interaction ---- */
let moved = false;
renderer_click_guard: {}
function onClick(e){
  raycaster.setFromCamera(
    new THREE.Vector2((e.clientX/innerWidth)*2-1, -(e.clientY/innerHeight)*2+1), camera);
  const hits = raycaster.intersectObjects(plotMeshes);
  if(!hits.length) return;
  const idx = hits[0].object.userData.plotIndex;
  handlePlotClick(idx);
}

function handlePlotClick(idx){
  const plot = state.plots[idx];
  if(plot){
    // maybe harvest
    const seed = seedById(plot.seedId);
    const progress = (Date.now()-plot.plantedAt)/1000/effectiveGrowSeconds(seed);
    if(progress>=1) harvest(idx);
    return;
  }
  if(!selectedSeed) return;
  if((state.seeds[selectedSeed]||0) <= 0) return;
  state.seeds[selectedSeed]--;
  state.plots[idx] = {seedId:selectedSeed, plantedAt: Date.now()};
  dropSeedPhysics(idx, selectedSeed);
  renderHotbar(); saveGarden();
}

function plotPos(idx){
  const offset = (PLOTS_SIDE-1)*PLOT_SIZE/2;
  const gx = idx % PLOTS_SIDE, gz = Math.floor(idx/PLOTS_SIDE);
  return new THREE.Vector3(gx*PLOT_SIZE-offset, 0.2, gz*PLOT_SIZE-offset);
}

function dropSeedPhysics(idx, seedId){
  const seed = seedById(seedId);
  const pos = plotPos(idx);
  const geo = new THREE.SphereGeometry(0.12, 8, 8);
  const mat = new THREE.MeshStandardMaterial({color:0x3b2a1c});
  const mesh = new THREE.Mesh(geo, mat);
  mesh.position.set(pos.x, 3.2, pos.z);
  mesh.castShadow = true;
  scene.add(mesh);
  fallingSeeds.push({mesh, vy:0, idx, bounced:0, targetY:pos.y});
}

function buildPlantGroup(seed){
  const g = new THREE.Group();
  const rarityInfo = RARITIES[seed.rarity];
  const glowParts = [];
  const leafMat = new THREE.MeshStandardMaterial({
    color: seed.leaf, roughness:.55, metalness:.05,
    emissive: rarityInfo.glow ? new THREE.Color(seed.leaf) : 0x000000,
    emissiveIntensity: rarityInfo.glow ? 0.5 : 0
  });
  const stemMat = new THREE.MeshStandardMaterial({color:0x4a7a34, roughness:.8});
  const potMat = new THREE.MeshStandardMaterial({color:0x3c2c1e, roughness:1});

  function addStem(h=0.75, r=0.045){
    const stem = new THREE.Mesh(new THREE.CylinderGeometry(r*0.7,r,h,6), stemMat);
    stem.position.y = h/2; stem.castShadow = true;
    g.add(stem);
    return h;
  }
  function addLeafPair(atY, count=3, size=0.16){
    for(let i=0;i<count;i++){
      const a = (i/count)*Math.PI*2 + 0.4;
      const leaf = new THREE.Mesh(new THREE.ConeGeometry(size*0.55,size*1.5,5), new THREE.MeshStandardMaterial({color:0x4f8f3a}));
      leaf.position.set(Math.cos(a)*size, atY, Math.sin(a)*size);
      leaf.rotation.x = Math.PI*0.18; leaf.rotation.y = a;
      leaf.castShadow = true;
      g.add(leaf);
    }
  }

  switch(seed.shape){
    case 'root': {
      addLeafPair(0.55, 4, 0.14);
      const bulb = new THREE.Mesh(new THREE.SphereGeometry(0.24,10,8), leafMat);
      bulb.scale.set(0.85,1.15,0.85);
      bulb.position.y = 0.16;
      bulb.castShadow = true;
      g.add(bulb); glowParts.push(bulb);
      break;
    }
    case 'leafy': {
      for(let ring=0; ring<3; ring++){
        const n = 5+ring*2, size = 0.16+ring*0.09, y = 0.12+ring*0.05;
        for(let i=0;i<n;i++){
          const a = (i/n)*Math.PI*2 + ring;
          const leaf = new THREE.Mesh(new THREE.SphereGeometry(size,6,5), leafMat);
          leaf.scale.set(1,0.35,1.4);
          leaf.position.set(Math.cos(a)*size*1.3, y, Math.sin(a)*size*1.3);
          leaf.rotation.y = a;
          leaf.castShadow = true;
          g.add(leaf);
          if(ring===2) glowParts.push(leaf);
        }
      }
      break;
    }
    case 'fruit': {
      const h = addStem(0.7);
      addLeafPair(h*0.55, 4, 0.2);
      const n = 2+Math.floor(Math.random()*2);
      for(let i=0;i<n;i++){
        const a = (i/n)*Math.PI*2;
        const fr = new THREE.Mesh(new THREE.SphereGeometry(0.19,10,8), leafMat);
        fr.position.set(Math.cos(a)*0.24, h*0.85, Math.sin(a)*0.24);
        fr.castShadow = true;
        g.add(fr); glowParts.push(fr);
      }
      break;
    }
    case 'berry': {
      const h = addStem(0.4, 0.035);
      addLeafPair(h*0.9, 3, 0.18);
      for(let i=0;i<3;i++){
        const a = (i/3)*Math.PI*2;
        const berry = new THREE.Mesh(new THREE.ConeGeometry(0.09,0.16,7), leafMat);
        berry.rotation.x = Math.PI;
        berry.position.set(Math.cos(a)*0.15, h*0.55, Math.sin(a)*0.15);
        berry.castShadow = true;
        g.add(berry); glowParts.push(berry);
      }
      break;
    }
    case 'bell': {
      const h = addStem(0.65);
      addLeafPair(h*0.5, 3, 0.18);
      const bell = new THREE.Mesh(new THREE.ConeGeometry(0.17,0.32,8), leafMat);
      bell.rotation.x = Math.PI;
      bell.position.y = h*0.95;
      bell.castShadow = true;
      g.add(bell); glowParts.push(bell);
      break;
    }
    case 'corn': {
      const h = addStem(1.15, 0.05);
      addLeafPair(h*0.35, 4, 0.32);
      addLeafPair(h*0.7, 3, 0.26);
      const cob = new THREE.Mesh(new THREE.CylinderGeometry(0.08,0.1,0.42,8), leafMat);
      cob.position.set(0.16, h*0.55, 0);
      cob.rotation.z = Math.PI*0.12;
      cob.castShadow = true;
      g.add(cob); glowParts.push(cob);
      const husk = new THREE.Mesh(new THREE.ConeGeometry(0.1,0.2,6), new THREE.MeshStandardMaterial({color:0x5fa04a}));
      husk.position.set(0.16, h*0.78, 0);
      husk.rotation.z = Math.PI*0.12;
      g.add(husk);
      break;
    }
    case 'pineapple': {
      const body = new THREE.Mesh(new THREE.CylinderGeometry(0.16,0.19,0.5,8), leafMat);
      body.position.y = 0.35; body.castShadow = true;
      g.add(body); glowParts.push(body);
      for(let i=0;i<7;i++){
        const a = (i/7)*Math.PI*2;
        const spike = new THREE.Mesh(new THREE.ConeGeometry(0.05,0.4,5), new THREE.MeshStandardMaterial({color:0x4f8f3a}));
        spike.position.set(Math.cos(a)*0.06, 0.68, Math.sin(a)*0.06);
        spike.rotation.z = Math.cos(a)*0.35; spike.rotation.x = Math.sin(a)*0.35;
        spike.castShadow = true;
        g.add(spike);
      }
      break;
    }
    case 'vine': {
      const h = addStem(0.9, 0.04);
      for(let i=0;i<4;i++){
        const a = (i/4)*Math.PI*2;
        const grape = new THREE.Mesh(new THREE.SphereGeometry(0.09,8,7), leafMat);
        grape.position.set(Math.cos(a)*0.22, h*0.55 - (i%2)*0.12, Math.sin(a)*0.22);
        grape.castShadow = true;
        g.add(grape); glowParts.push(grape);
      }
      addLeafPair(h*0.95, 3, 0.22);
      break;
    }
    case 'flower': {
      const h = addStem(0.85, 0.035);
      addLeafPair(h*0.4, 2, 0.2);
      const center = new THREE.Mesh(new THREE.SphereGeometry(0.09,8,7), new THREE.MeshStandardMaterial({color:0xffe27a}));
      center.position.y = h; g.add(center);
      for(let i=0;i<6;i++){
        const a = (i/6)*Math.PI*2;
        const petal = new THREE.Mesh(new THREE.SphereGeometry(0.1,7,6), leafMat);
        petal.scale.set(1.6,0.4,0.7);
        petal.position.set(Math.cos(a)*0.16, h, Math.sin(a)*0.16);
        petal.rotation.y = a;
        petal.castShadow = true;
        g.add(petal); glowParts.push(petal);
      }
      break;
    }
    case 'crystal': {
      for(let i=0;i<4;i++){
        const a = (i/4)*Math.PI*2;
        const size = i===0?0.28:0.16;
        const shard = new THREE.Mesh(new THREE.OctahedronGeometry(size,0), leafMat);
        shard.position.set(Math.cos(a)*0.12, size*0.9, Math.sin(a)*0.12);
        shard.rotation.y = a;
        shard.castShadow = true;
        g.add(shard); glowParts.push(shard);
      }
      break;
    }
    case 'tree': {
      const trunk = new THREE.Mesh(new THREE.CylinderGeometry(0.05,0.08,0.55,6), stemMat);
      trunk.position.y = 0.28; trunk.castShadow = true;
      g.add(trunk);
      for(let i=0;i<3;i++){
        const a = (i/3)*Math.PI*2;
        const gem = new THREE.Mesh(new THREE.IcosahedronGeometry(0.16,0), leafMat);
        gem.position.set(Math.cos(a)*0.16, 0.62+i*0.1, Math.sin(a)*0.16);
        gem.castShadow = true;
        g.add(gem); glowParts.push(gem);
      }
      const top = new THREE.Mesh(new THREE.IcosahedronGeometry(0.2,0), leafMat);
      top.position.y = 0.95;
      g.add(top); glowParts.push(top);
      break;
    }
    default: {
      const h = addStem(0.7);
      const bulb = new THREE.Mesh(new THREE.IcosahedronGeometry(0.24,0), leafMat);
      bulb.position.y = h; g.add(bulb); glowParts.push(bulb);
    }
  }

  // petit pot / motte de terre commune à toutes les plantes
  const mound = new THREE.Mesh(new THREE.CylinderGeometry(0.28,0.32,0.1,10), potMat);
  mound.position.y = 0.03; mound.receiveShadow = true; mound.castShadow = true;
  g.add(mound);

  g.userData.glowParts = glowParts;
  g.userData.rarityGlow = rarityInfo.glow;
  return g;
}

function ensurePlantVisual(idx){
  const plot = state.plots[idx];
  if(!plot) return;
  if(plantGroups[idx]) return;
  const seed = seedById(plot.seedId);
  const g = buildPlantGroup(seed);
  const pos = plotPos(idx);
  g.position.set(pos.x, pos.y, pos.z);
  g.scale.set(0.05,0.05,0.05);
  scene.add(g);
  plantGroups[idx] = g;
}

function harvest(idx){
  const plot = state.plots[idx];
  if(!plot) return;
  const g = plantGroups[idx];
  if(g){
    let t=0;
    const anim = ()=>{
      t+=0.06;
      const s = Math.max(0, 1.4 - t*1.4);
      g.scale.set(s,s*1.3,s);
      g.position.y = plotPos(idx).y + t*1.2;
      if(t<1) requestAnimationFrame(anim);
      else { scene.remove(g); delete plantGroups[idx]; }
    };
    anim();
  }
  state.produce[plot.seedId] = (state.produce[plot.seedId]||0)+eventHarvestMult();
  state.plots[idx] = null;
  saveGarden(); renderInventory();
  if(document.getElementById('panel-sell').classList.contains('open')) renderSell();
}

/* ---- animation loop ---- */
function animate(){
  requestAnimationFrame(animate);
  const dt = Math.min(clock.getDelta(), 0.05);
  windTime += dt;

  // papillons — vol en boucle de Lissajous, battement d'ailes
  butterflies.forEach(b=>{
    const t = windTime*b.speed + b.phase;
    b.group.position.set(Math.cos(t)*b.radius, b.height + Math.sin(t*2.3)*0.4, Math.sin(t*1.3)*b.radius*0.7);
    b.group.rotation.y = -t*1.3 + Math.PI/2;
    const flap = Math.sin(windTime*14 + b.phase);
    b.group.userData.wings[0].rotation.y = flap*0.9;
    b.group.userData.wings[1].rotation.y = -flap*0.9;
  });

  // falling seeds physics
  for(let i=fallingSeeds.length-1;i>=0;i--){
    const f = fallingSeeds[i];
    f.vy += GRAV*dt;
    f.mesh.position.y += f.vy*dt;
    if(f.mesh.position.y <= f.targetY+0.08){
      if(f.bounced < 1){
        f.vy *= -0.32; f.bounced++;
      } else {
        f.mesh.position.y = f.targetY+0.08;
        scene.remove(f.mesh);
        fallingSeeds.splice(i,1);
        ensurePlantVisual(f.idx);
        continue;
      }
    }
  }

  // grow plants
  Object.keys(state.plots).forEach(k=>{
    const idx = +k;
    const plot = state.plots[idx];
    if(!plot) return;
    ensurePlantVisual(idx);
    const g = plantGroups[idx];
    if(!g) return;
    const seed = seedById(plot.seedId);
    const progress = Math.min(1, (Date.now()-plot.plantedAt)/1000/effectiveGrowSeconds(seed));
    const scale = 0.08 + progress*1.05;
    const basePos = plotPos(idx);
    let bob = 0;
    if(progress>=1){
      bob = Math.sin(windTime*3 + idx)*0.05;
      if(g.userData.rarityGlow && g.userData.glowParts){
        const pulse = 0.4 + Math.sin(windTime*4+idx)*0.3;
        g.userData.glowParts.forEach(m=> m.material.emissiveIntensity = pulse);
      }
    }
    g.scale.set(scale, scale, scale);
    g.position.set(basePos.x, basePos.y + bob, basePos.z);
    g.rotation.z = Math.sin(windTime*1.4 + idx*0.7)*0.06*progress;
    g.rotation.x = Math.sin(windTime*1.1 + idx*0.5)*0.03*progress;
  });

  renderer.render(scene, camera);
}

