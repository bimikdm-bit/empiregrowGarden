<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>Racines — jardin partagé</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,700;1,500&family=Karla:wght@400;600;700&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<style>
  :root{
    --soil:#4A3427; --soil-light:#6B4A35; --moss:#4F7942; --meadow:#8FBF6F;
    --cream:#F7F0E1; --sun:#E3A857;
    --c-commune:#7C9473; --c-peu:#4FA8A0; --c-rare:#4A7FBF; --c-epique:#9B5FC9; --c-legend:#D99A2B;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;height:100%;overflow:hidden;font-family:'Karla',sans-serif;background:var(--soil);}
  #scene{position:fixed;inset:0;}
  h1,h2,h3,.font-display{font-family:'Fraunces',serif;}

  /* ---- start overlay ---- */
  #start{position:fixed;inset:0;background:radial-gradient(circle at 50% 30%,#7c9a5f,#3c4f2b 75%);
    display:flex;align-items:center;justify-content:center;z-index:50;}
  #start .card{background:var(--cream);border-radius:18px;padding:36px 40px;max-width:380px;text-align:center;
    box-shadow:0 20px 60px rgba(0,0,0,.4);border:3px solid var(--soil);}
  #start h1{margin:0 0 6px;color:var(--soil);font-size:34px;font-style:italic;}
  #start p{color:#5c4a36;font-size:14px;line-height:1.5;margin:0 0 18px;}
  #start input{width:100%;padding:10px 12px;border-radius:10px;border:2px solid var(--soil-light);font-size:15px;
    font-family:'Karla';margin-bottom:14px;background:#fffdf8;}
  #start button{width:100%;padding:11px;border:none;border-radius:10px;background:var(--moss);color:#fff;
    font-weight:700;font-size:15px;cursor:pointer;letter-spacing:.3px;}
  #start button:hover{background:#3d6032;}

  /* ---- HUD ---- */
  #hud{position:fixed;top:14px;left:14px;right:14px;display:flex;justify-content:space-between;
    pointer-events:none;z-index:10;}
  .pill{pointer-events:auto;background:rgba(247,240,225,.95);border:2px solid var(--soil);border-radius:30px;
    padding:8px 16px;display:flex;align-items:center;gap:8px;color:var(--soil);font-weight:700;font-size:14px;
    box-shadow:0 4px 12px rgba(0,0,0,.25);}
  #players-pill{cursor:default;}
  .dot{width:8px;height:8px;border-radius:50%;background:#3fae4a;box-shadow:0 0 6px #3fae4a;}

  /* ---- bottom bar ---- */
  #bottombar{position:fixed;bottom:14px;left:50%;transform:translateX(-50%);z-index:10;
    display:flex;gap:10px;align-items:flex-end;}
  .barbtn{pointer-events:auto;background:var(--soil);color:var(--cream);border:none;border-radius:14px;
    padding:12px 18px;font-family:'Fraunces';font-size:15px;cursor:pointer;box-shadow:0 6px 16px rgba(0,0,0,.35);}
  .barbtn:hover{background:#2f2116;}
  #hotbar{display:flex;gap:6px;background:rgba(74,52,39,.9);padding:8px;border-radius:14px;
    box-shadow:0 6px 16px rgba(0,0,0,.35);}
  .hotslot{width:52px;height:52px;border-radius:10px;background:#5c4230;border:2px solid transparent;
    display:flex;flex-direction:column;align-items:center;justify-content:center;cursor:pointer;position:relative;color:#fff;}
  .hotslot.selected{border-color:var(--sun);box-shadow:0 0 10px var(--sun);}
  .hotslot .cnt{position:absolute;bottom:1px;right:3px;font-size:10px;background:#000a;padding:0 3px;border-radius:5px;}
  .hotslot .ic{width:20px;height:20px;border-radius:50%;}

  /* ---- panels (shop / inventory / chat) ---- */
  .panel{position:fixed;top:0;right:-420px;width:390px;height:100%;background:var(--cream);z-index:20;
    box-shadow:-10px 0 30px rgba(0,0,0,.4);transition:right .25s ease;display:flex;flex-direction:column;}
  .panel.open{right:0;}
  .panel-head{padding:16px 18px 10px;border-bottom:2px solid var(--soil-light);display:flex;
    justify-content:space-between;align-items:center;}
  .panel-head h2{margin:0;color:var(--soil);font-size:20px;}
  .panel-head button{background:none;border:none;font-size:20px;cursor:pointer;color:var(--soil);}
  .panel-body{flex:1;overflow-y:auto;padding:12px 14px;}
  .rarity-label{font-family:'Fraunces';font-size:13px;text-transform:uppercase;letter-spacing:1px;
    margin:14px 0 6px;font-weight:700;}
  .seedcard{display:flex;align-items:center;gap:10px;background:#fffdf7;border-radius:12px;padding:8px 10px;
    margin-bottom:7px;border:2px solid #e6dcc4;}
  .seedcard .ic{width:34px;height:34px;border-radius:50%;flex-shrink:0;border:2px solid rgba(0,0,0,.15);}
  .seedcard .info{flex:1;min-width:0;}
  .seedcard .info .nm{font-weight:700;color:var(--soil);font-size:13.5px;}
  .seedcard .info .sub{font-size:11px;color:#8a7a63;}
  .seedcard button{border:none;border-radius:8px;padding:7px 10px;font-weight:700;font-size:12px;cursor:pointer;
    background:var(--moss);color:#fff;white-space:nowrap;}
  .seedcard button:disabled{background:#c8c0ac;cursor:not-allowed;color:#8a8270;}

  .inv-row{display:flex;align-items:center;gap:10px;background:#fffdf7;border-radius:12px;padding:8px 10px;
    margin-bottom:7px;border:2px solid #e6dcc4;}
  .inv-row .ic{width:30px;height:30px;border-radius:50%;flex-shrink:0;}
  .inv-row .nm{flex:1;font-weight:700;font-size:13px;color:var(--soil);}
  .inv-row .cnt{font-size:12px;color:#8a7a63;margin-right:6px;}
  .inv-row button{border:none;border-radius:8px;padding:6px 9px;font-size:11px;font-weight:700;cursor:pointer;
    background:var(--sun);color:#3a2a10;}
  .empty-note{color:#8a7a63;font-size:13px;text-align:center;padding:30px 10px;}

  #sell-total{border-top:2px solid var(--soil-light);padding:12px 16px;display:flex;justify-content:space-between;
    align-items:center;background:#fffdf7;}
  #sell-total .lbl{font-size:12.5px;color:#8a7a63;font-weight:700;text-transform:uppercase;letter-spacing:.5px;}
  #sell-total .val{font-family:'Fraunces';font-size:20px;color:var(--soil);font-weight:700;}
  #sell-total button{border:none;border-radius:10px;padding:10px 16px;font-weight:700;font-size:13px;cursor:pointer;
    background:var(--sun);color:#3a2a10;}
  #sell-total button:disabled{background:#ded4bb;color:#a89a80;cursor:not-allowed;}
  .sell-row{display:flex;align-items:center;gap:10px;background:#fffdf7;border-radius:12px;padding:9px 10px;
    margin-bottom:7px;border:2px solid #e6dcc4;}
  .sell-row .ic{width:32px;height:32px;border-radius:50%;flex-shrink:0;border:2px solid rgba(0,0,0,.15);}
  .sell-row .info{flex:1;min-width:0;}
  .sell-row .info .nm{font-weight:700;color:var(--soil);font-size:13px;}
  .sell-row .info .sub{font-size:11px;color:#8a7a63;}
  .sell-row .qtybtns{display:flex;gap:5px;}
  .sell-row .qtybtns button{border:none;border-radius:7px;padding:6px 9px;font-size:11px;font-weight:700;cursor:pointer;}
  .sell-row .qtybtns button.one{background:#e8e0c8;color:var(--soil);}
  .sell-row .qtybtns button.all{background:var(--moss);color:#fff;}

  #event-banner{position:fixed;top:60px;left:50%;transform:translateX(-50%);z-index:11;
    background:linear-gradient(135deg,#3d6032,#2c481f);color:#fff;border-radius:16px;padding:9px 18px;
    display:flex;align-items:center;gap:10px;box-shadow:0 6px 18px rgba(0,0,0,.35);border:2px solid #E3A857;
    font-size:13px;white-space:nowrap;}
  #event-banner .evtitle{font-family:'Fraunces';font-weight:700;font-size:14px;}
  #event-banner .evtimer{background:rgba(0,0,0,.3);padding:2px 9px;border-radius:10px;font-weight:700;font-size:12px;}

  #wheel-wrap{position:relative;width:280px;height:280px;margin-top:6px;}
  #wheel-pointer{position:absolute;top:-6px;left:50%;transform:translateX(-50%);font-size:26px;color:var(--soil);
    z-index:2;filter:drop-shadow(0 2px 2px rgba(0,0,0,.4));}
  #wheel-canvas{border-radius:50%;box-shadow:0 8px 24px rgba(0,0,0,.35);border:5px solid var(--soil);transition:transform 4.2s cubic-bezier(.15,.85,.15,1);}
  #wheel-spin-btn:disabled{background:#a89a80;cursor:not-allowed;}
  #wheel-result{margin-top:14px;text-align:center;font-size:13.5px;color:var(--soil);min-height:20px;font-weight:700;}

  #chat-log{flex:1;overflow-y:auto;padding:10px 14px;display:flex;flex-direction:column;gap:6px;}
  .msg{font-size:13px;line-height:1.35;}
  .msg .who{font-weight:700;color:var(--moss);}
  .msg.sys{color:#8a7a63;font-style:italic;}
  #chat-form{display:flex;border-top:2px solid var(--soil-light);padding:10px;gap:6px;}
  #chat-input{flex:1;border:2px solid #d8cba9;border-radius:20px;padding:8px 14px;font-family:'Karla';font-size:13px;}
  #chat-form button{border:none;background:var(--soil);color:#fff;border-radius:20px;padding:8px 16px;
    font-weight:700;cursor:pointer;}

  #tip{position:fixed;bottom:96px;left:50%;transform:translateX(-50%);background:rgba(0,0,0,.72);color:#fff;
    padding:7px 16px;border-radius:20px;font-size:12.5px;z-index:9;pointer-events:none;white-space:nowrap;}

  ::-webkit-scrollbar{width:7px;}
  ::-webkit-scrollbar-thumb{background:#d3c6a4;border-radius:6px;}
</style>
</head>
<body>

<div id="start">
  <div class="card">
    <h1>🌱 Racines</h1>
    <p>Un jardin partagé. Achète des graines rares (stock limité, commun à tout le monde), plante-les dans ta parcelle, regarde-les pousser avec le vent, récolte, et discute avec les autres jardiniers.</p>
    <input id="name-input" maxlength="16" placeholder="Ton pseudo de jardinier…">
    <button id="start-btn">Entrer dans le jardin</button>
  </div>
</div>

<div id="scene"></div>

<div id="hud" style="display:none">
  <div class="pill">🪙 <span id="coins">0</span></div>
  <div style="display:flex;gap:8px;pointer-events:none;">
    <div class="pill" id="players-pill"><span class="dot"></span> <span id="players-count">1</span> jardinier(s) en ligne</div>
    <div class="pill" id="sound-toggle" style="cursor:pointer;pointer-events:auto;">🔊</div>
  </div>
</div>

<div id="event-banner" style="display:none"></div>

<div id="tip" style="display:none">Sélectionne une graine puis clique une parcelle pour planter · clique une plante prête pour récolter</div>

<div id="bottombar" style="display:none">
  <button class="barbtn" id="btn-shop">🛒 Boutique</button>
  <div id="hotbar"></div>
  <button class="barbtn" id="btn-inv">🎒 Sac</button>
  <button class="barbtn" id="btn-sell">💰 Vente</button>
  <button class="barbtn" id="btn-wheel">🎡 Roue</button>
  <button class="barbtn" id="btn-chat">💬 Chat</button>
</div>

<!-- SHOP -->
<div class="panel" id="panel-shop">
  <div class="panel-head"><h2>Boutique</h2><button data-close="panel-shop">✕</button></div>
  <div class="panel-body" id="shop-body"></div>
</div>

<!-- INVENTORY -->
<div class="panel" id="panel-inv">
  <div class="panel-head"><h2>Mon sac</h2><button data-close="panel-inv">✕</button></div>
  <div class="panel-body" id="inv-body"></div>
</div>

<!-- SELL SHOP -->
<div class="panel" id="panel-sell">
  <div class="panel-head"><h2>Boutique de vente</h2><button data-close="panel-sell">✕</button></div>
  <div class="panel-body" id="sell-body"></div>
  <div id="sell-total"></div>
</div>

<!-- WHEEL OF FORTUNE -->
<div class="panel" id="panel-wheel">
  <div class="panel-head"><h2>Roue de la chance</h2><button data-close="panel-wheel">✕</button></div>
  <div class="panel-body" style="display:flex;flex-direction:column;align-items:center;">
    <div id="wheel-wrap">
      <div id="wheel-pointer">▼</div>
      <canvas id="wheel-canvas" width="280" height="280"></canvas>
    </div>
    <button id="wheel-spin-btn" class="barbtn" style="margin-top:18px;width:220px;"></button>
    <div id="wheel-result"></div>
  </div>
</div>

<!-- CHAT -->
<div class="panel" id="panel-chat">
  <div class="panel-head"><h2>Chat du jardin</h2><button data-close="panel-chat">✕</button></div>
  <div id="chat-log"></div>
  <form id="chat-form"><input id="chat-input" autocomplete="off" placeholder="Écris un message…"><button type="submit">Envoyer</button></form>
</div>

<script>
/* =========================================================
   DONNÉES DE JEU
========================================================= */
const RARITIES = {
  commune:  {label:'Commune',       color:'#7C9473', stock:60, glow:false},
  peu:      {label:'Peu commune',   color:'#4FA8A0', stock:28, glow:false},
  rare:     {label:'Rare',          color:'#4A7FBF', stock:12, glow:false},
  epique:   {label:'Épique',        color:'#9B5FC9', stock:6,  glow:true},
  legend:   {label:'Légendaire',    color:'#D99A2B', stock:2,  glow:true},
};

const SEEDS = [
  {id:'radis',    name:'Radis',            rarity:'commune', price:8,   grow:14, sell:14,  leaf:0x6fae4b, shape:'root'},
  {id:'laitue',   name:'Laitue',           rarity:'commune', price:10,  grow:16, sell:17,  leaf:0x7fc25a, shape:'leafy'},
