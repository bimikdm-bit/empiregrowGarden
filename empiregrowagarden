let currentEvent = null;
let lastHeardEventStart = 0;

function eventGrowMult(){ return (currentEvent && currentEvent.effect.growMult) || 1; }
function eventSellMult(){ return (currentEvent && currentEvent.effect.sellMult) || 1; }
function eventWheelDiscount(){ return (currentEvent && currentEvent.effect.wheelDiscount) || 1; }
function eventBuyDiscount(){ return (currentEvent && currentEvent.effect.buyDiscount) || 1; }
function eventHarvestMult(){ return (currentEvent && currentEvent.effect.doubleHarvest) ? 2 : 1; }
function effectiveGrowSeconds(seed){ return seed.grow / eventGrowMult(); }
function sellPriceFor(seed){ return Math.round(seed.sell * eventSellMult()); }
function buyPriceFor(seed){ return Math.max(1, Math.round(seed.price * eventBuyDiscount())); }

async function pollEvents(){
  const now = Date.now();
  const ev = await sGet('event:state', true);
  if(ev && ev.endsAt > now){
    currentEvent = ev;
  } else {
    const wasActive = !!currentEvent;
    currentEvent = null;
    if(Math.random() < 0.3){
      const def = EVENTS[Math.floor(Math.random()*EVENTS.length)];
      const newEv = {id:def.id, label:def.label, desc:def.desc, effect:def.effect, startedAt:now, endsAt: now+def.duration*1000};
      await sSet('event:state', newEv, true);
      currentEvent = newEv;
      if(def.effect.restock){
        const fresh = {}; SEEDS.forEach(s=> fresh[s.id]=RARITIES[s.rarity].stock);
        shopStock = fresh; await sSet('shop:stock', fresh, true);
        if(document.getElementById('panel-shop').classList.contains('open')) renderShop();
      }
      if(def.effect.coinBonus){
        state.coins += def.effect.coinBonus;
        saveGarden(); renderHUD();
      }
      pushChat(`📢 ${def.label} : ${def.desc} !`);
    } else if(wasActive){
      // event just ended silently on this client
    }
  }
  if(currentEvent && currentEvent.startedAt !== lastHeardEventStart){
    lastHeardEventStart = currentEvent.startedAt;
    playJingle(EVENT_MUSIC[currentEvent.id]);
  }
  renderEventBanner();
}
function renderEventBanner(){
  const el = document.getElementById('event-banner');
  if(!currentEvent){ el.style.display='none'; return; }
  const secsLeft = Math.max(0, Math.round((currentEvent.endsAt - Date.now())/1000));
  const m = Math.floor(secsLeft/60), s = String(secsLeft%60).padStart(2,'0');
  el.style.display = 'flex';
  el.innerHTML = `<span class="evtitle">${currentEvent.label}</span><span>${currentEvent.desc}</span><span class="evtimer">${m}:${s}</span>`;
}

