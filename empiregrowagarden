  {id:'tomate',   name:'Tomate',           rarity:'commune', price:14,  grow:20, sell:24,  leaf:0xd6472b, shape:'fruit'},
  {id:'patate',   name:'Pomme de terre',   rarity:'commune', price:11,  grow:17, sell:18,  leaf:0xc99a52, shape:'root'},
  {id:'fraise',   name:'Fraise',           rarity:'commune', price:16,  grow:22, sell:28,  leaf:0xe0416b, shape:'berry'},
  {id:'mais',     name:'Maïs doré',        rarity:'peu',     price:28,  grow:32, sell:48,  leaf:0xe6c332, shape:'corn'},
  {id:'citrouille',name:'Citrouille',      rarity:'peu',     price:32,  grow:35, sell:55,  leaf:0xe57a26, shape:'fruit'},
  {id:'poivron',  name:'Poivron',          rarity:'peu',     price:26,  grow:30, sell:44,  leaf:0x3fae53, shape:'bell'},
  {id:'melon',    name:'Melon musqué',     rarity:'peu',     price:34,  grow:38, sell:58,  leaf:0xa9c94e, shape:'fruit'},
  {id:'ananas',   name:'Ananas',           rarity:'rare',    price:60,  grow:50, sell:110, leaf:0xd8c536, shape:'pineapple'},
  {id:'pasteque', name:'Pastèque géante',  rarity:'rare',    price:70,  grow:55, sell:130, leaf:0x3a9b4d, shape:'fruit'},
  {id:'artichaut',name:'Artichaut',        rarity:'rare',    price:55,  grow:48, sell:100, leaf:0x6f8f5b, shape:'leafy'},
  {id:'aubergine',name:'Aubergine violette',rarity:'rare',   price:58,  grow:50, sell:105, leaf:0x6a3f8f, shape:'bell'},
  {id:'vigneor',  name:'Vigne dorée',      rarity:'epique',  price:130, grow:75, sell:250, leaf:0xe8b93f, shape:'vine'},
  {id:'fleurlune',name:'Fleur de lune',    rarity:'epique',  price:140, grow:80, sell:270, leaf:0x8fb7e8, shape:'flower'},
  {id:'cactuscri',name:'Cactus de cristal',rarity:'epique',  price:150, grow:85, sell:290, leaf:0x5fe0c9, shape:'crystal'},
  {id:'arbrediam',name:'Pousse de diamant',rarity:'legend',  price:400, grow:130,sell:900, leaf:0xbfe8ff, shape:'tree'},
  {id:'phenix',   name:'Fleur phénix',     rarity:'legend',  price:420, grow:140,sell:950, leaf:0xff6a3d, shape:'flower'},
];
const seedById = id => SEEDS.find(s=>s.id===id);
const PLOTS_SIDE = 6;
const PLOT_SIZE = 2.1;
const GRAV = -9.8;

/* =========================================================
   ROUE DE LA CHANCE
========================================================= */
const WHEEL_SPIN_COST = 25;
const WHEEL_SEGMENTS = [
  {type:'coins', amount:10,  color:'#7C9473', label:'+10'},
  {type:'seed',  id:'laitue', color:'#8FBF6F', label:'Laitue'},
  {type:'coins', amount:20,  color:'#4FA8A0', label:'+20'},
  {type:'seed',  id:'carotte',color:'#E08A2B', label:'Carotte'},
  {type:'coins', amount:50,  color:'#7C9473', label:'+50'},
  {type:'seed',  id:'tomate', color:'#D6472B', label:'Tomate'},
  {type:'coins', amount:100, color:'#4A7FBF', label:'+100'},
  {type:'seedRare', color:'#9B5FC9', label:'Graine rare'},
  {type:'coins', amount:15,  color:'#4FA8A0', label:'+15'},
  {type:'jackpot', amount:500, color:'#D99A2B', label:'JACKPOT'},
];

/* =========================================================
   AUDIO — un jingle procédural unique par évènement (Web Audio API)
========================================================= */
let audioCtx = null, masterGain = null;
let soundOn = true;
const NOTE_IDX = {C:0,'C#':1,D:2,'D#':3,E:4,F:5,'F#':6,G:7,'G#':8,A:9,'A#':10,B:11};
function noteFreq(note){
  const m = note.match(/^([A-G]#?)(\d)$/);
  const midi = (parseInt(m[2])+1)*12 + NOTE_IDX[m[1]];
  return 440 * Math.pow(2, (midi-69)/12);
}
function initAudio(){
  if(audioCtx) return;
  try{
    const AC = window.AudioContext || window.webkitAudioContext;
    audioCtx = new AC();
    masterGain = audioCtx.createGain();
    masterGain.gain.value = 0.22;
    masterGain.connect(audioCtx.destination);
  }catch(e){ audioCtx = null; }
}
function playNote(freq, startTime, dur, waveform){
  const osc = audioCtx.createOscillator();
  const g = audioCtx.createGain();
  osc.type = waveform;
  osc.frequency.value = freq;
  g.gain.setValueAtTime(0, startTime);
  g.gain.linearRampToValueAtTime(1, startTime+0.02);
  g.gain.exponentialRampToValueAtTime(0.001, startTime+dur);
  osc.connect(g).connect(masterGain);
  osc.start(startTime);
  osc.stop(startTime+dur+0.05);
}
function playJingle(def){
  if(!soundOn || !audioCtx || !def) return;
  if(audioCtx.state === 'suspended') audioCtx.resume();
  let t = audioCtx.currentTime + 0.02;
  def.notes.forEach(([n,d])=>{
    playNote(noteFreq(n), t, d, def.wave);
    t += d*0.88;
  });
}

/* Signature musicale de chaque évènement — mélodie + timbre distincts */
const EVENT_MUSIC = {
  pluie:     {wave:'triangle', notes:[['C4',.15],['E4',.15],['G4',.15],['C5',.32]]},
  lune:      {wave:'sine',     notes:[['E5',.16],['C5',.16],['G4',.32]]},
  chance:    {wave:'square',   notes:[['G4',.1],['B4',.1],['D5',.1],['G5',.28]]},
  marche:    {wave:'sine',     notes:[['C5',.12],['D5',.12],['E5',.12],['G5',.3]]},
  chaleur:   {wave:'triangle', notes:[['D4',.15],['F#4',.15],['A4',.32]]},
  arcenciel: {wave:'sine',     notes:[['C5',.1],['E5',.1],['G5',.1],['C6',.1],['G5',.1],['E5',.3]]},
  foire:     {wave:'sawtooth', notes:[['G4',.12],['C5',.12],['E5',.12],['G5',.26]]},
  abeilles:  {wave:'triangle', notes:[['A4',.08],['B4',.08],['A4',.08],['B4',.08],['C#5',.26]]},
  tresor:    {wave:'square',   notes:[['E5',.12],['G#5',.12],['B5',.36]]},
  nuit:      {wave:'sine',     notes:[['A3',.16],['E4',.16],['A4',.32]]},
  automne:   {wave:'triangle', notes:[['F4',.15],['A4',.15],['C5',.32]]},
  eclosion:  {wave:'triangle', notes:[['C4',.08],['D4',.08],['E4',.08],['F4',.08],['G4',.08],['A4',.08],['B4',.08],['C5',.26]]},
  carnaval:  {wave:'square',   notes:[['D5',.1],['F#5',.1],['A5',.1],['D6',.26]]},
  soldes:    {wave:'sawtooth', notes:[['A4',.12],['C5',.12],['E5',.3]]},
  papillon:  {wave:'triangle', notes:[['E4',.1],['G4',.1],['B4',.1],['E5',.3]]},
  maree:     {wave:'sine',     notes:[['D4',.15],['A4',.15],['D5',.32]]},
  royale:    {wave:'square',   notes:[['C5',.12],['E5',.12],['G5',.12],['C6',.28],['G5',.14],['C6',.36]]},
};

/* =========================================================
   ÉVÈNEMENTS DE SERVEUR
========================================================= */
const EVENTS = [
  {id:'pluie',    label:'🌧️ Pluie bénie',        desc:'Croissance des plantes 2× plus rapide',              duration:100, effect:{growMult:2}},
  {id:'lune',     label:'🌕 Pleine lune',         desc:'Les récoltes se vendent 60% plus cher',               duration:90,  effect:{sellMult:1.6}},
  {id:'chance',   label:'🍀 Vent de chance',      desc:'La roue de la chance coûte moitié prix',              duration:80,  effect:{wheelDiscount:0.5}},
  {id:'marche',   label:'⭐ Marché étoilé',        desc:'Le stock de graines vient d\'être réapprovisionné',   duration:60,  effect:{restock:true}},
