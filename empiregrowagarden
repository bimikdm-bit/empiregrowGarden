function renderShop(){
  const body = document.getElementById('shop-body');
  let html = '';
  Object.keys(RARITIES).forEach(rk=>{
    const rar = RARITIES[rk];
    const seedsOfRarity = SEEDS.filter(s=>s.rarity===rk);
    html += `<div class="rarity-label" style="color:${rar.color}">${rar.label}</div>`;
    seedsOfRarity.forEach(s=>{
      const stock = shopStock[s.id] ?? 0;
      const price = buyPriceFor(s);
      const canBuy = stock>0 && state.coins>=price;
      html += `<div class="seedcard">
        <div class="ic" style="background:#${s.leaf.toString(16).padStart(6,'0')};border-color:${rar.color}"></div>
        <div class="info">
          <div class="nm">${s.name}</div>
          <div class="sub">🪙 ${price}${price<s.price?` <s style="opacity:.6">${s.price}</s>`:''} · pousse ${effectiveGrowSeconds(s).toFixed(0)}s · stock ${stock}</div>
        </div>
        <button data-buy="${s.id}" ${canBuy?'':'disabled'}>${stock<=0?'Épuisé':'Acheter'}</button>
      </div>`;
    });
  });
  body.innerHTML = html;
  body.querySelectorAll('[data-buy]').forEach(btn=>{
    btn.onclick = ()=>buySeed(btn.dataset.buy);
  });
}

async function buySeed(id){
  const seed = seedById(id);
  const price = buyPriceFor(seed);
  await ensureShopStock();
  if((shopStock[id]||0) <= 0 || state.coins < price) { renderShop(); return; }
  shopStock[id]--;
  state.coins -= price;
  state.seeds[id] = (state.seeds[id]||0)+1;
  await sSet('shop:stock', shopStock, true);
  saveGarden();
  renderShop(); renderHotbar(); renderHUD();
}

function renderInventory(){
  const body = document.getElementById('inv-body');
  let html = '<div class="rarity-label" style="color:var(--soil)">Graines</div>';
  const seedIds = Object.keys(state.seeds).filter(k=>state.seeds[k]>0);
  if(!seedIds.length) html += '<div class="empty-note">Aucune graine — passe à la boutique.</div>';
  seedIds.forEach(id=>{
    const s = seedById(id);
    html += `<div class="inv-row"><div class="ic" style="background:#${s.leaf.toString(16).padStart(6,'0')}"></div>
      <div class="nm">${s.name}</div><div class="cnt">x${state.seeds[id]}</div></div>`;
  });
  const prodTotal = Object.keys(state.produce).reduce((a,k)=>a+(state.produce[k]||0),0);
  html += `<div class="rarity-label" style="color:var(--soil)">Récoltes</div>`;
  if(!prodTotal) html += '<div class="empty-note">Rien récolté pour l\'instant.</div>';
  else html += `<div class="empty-note" style="padding:14px 10px">${prodTotal} récolte(s) en réserve — vends-les à la <strong>Boutique de vente</strong> 💰.</div>`;
  body.innerHTML = html;
}

/* ---- roue de la chance ---- */
let wheelRotation = 0;
let wheelSpinning = false;

function drawWheel(){
  const canvas = document.getElementById('wheel-canvas');
  const ctx = canvas.getContext('2d');
  const cx = 140, cy = 140, r = 136;
  const n = WHEEL_SEGMENTS.length;
  const seg = Math.PI*2/n;
  ctx.clearRect(0,0,280,280);
  WHEEL_SEGMENTS.forEach((s,i)=>{
    const start = i*seg - Math.PI/2, end = start+seg;
    ctx.beginPath();
    ctx.moveTo(cx,cy);
    ctx.arc(cx,cy,r,start,end);
    ctx.closePath();
    ctx.fillStyle = s.color;
    ctx.fill();
    ctx.strokeStyle = '#F7F0E1';
    ctx.lineWidth = 2;
    ctx.stroke();
    ctx.save();
    ctx.translate(cx,cy);
    ctx.rotate(start+seg/2);
    ctx.textAlign = 'right';
    ctx.fillStyle = '#fff';
    ctx.font = 'bold 12px Karla, sans-serif';
    ctx.shadowColor = 'rgba(0,0,0,.5)'; ctx.shadowBlur = 3;
    ctx.fillText(s.label, r-14, 5);
    ctx.restore();
  });
  ctx.beginPath();
  ctx.arc(cx,cy,18,0,Math.PI*2);
  ctx.fillStyle = '#F7F0E1';
  ctx.fill();
  ctx.strokeStyle = '#4A3427'; ctx.lineWidth = 3; ctx.stroke();
}

function renderWheel(){
  drawWheel();
  const cost = Math.round(WHEEL_SPIN_COST * eventWheelDiscount());
  const btn = document.getElementById('wheel-spin-btn');
  btn.textContent = `Tourner — 🪙 ${cost}`;
  btn.disabled = state.coins < cost || wheelSpinning;
  document.getElementById('wheel-result').textContent = '';
}

function pickWeightedSegment(){
  // graines communes/pièces plus fréquentes, jackpot et rare plus rares — pondéré via poids par type
  const weights = WHEEL_SEGMENTS.map(s=> s.type==='jackpot' ? 1 : s.type==='seedRare' ? 4 : 12);
  const total = weights.reduce((a,b)=>a+b,0);
  let r = Math.random()*total;
  for(let i=0;i<weights.length;i++){
    if(r < weights[i]) return i;
    r -= weights[i];
  }
  return 0;
}

function spinWheel(){
  if(wheelSpinning) return;
  const cost = Math.round(WHEEL_SPIN_COST * eventWheelDiscount());
  if(state.coins < cost) return;
  state.coins -= cost;
  renderHUD();
  wheelSpinning = true;
  document.getElementById('wheel-spin-btn').disabled = true;
  document.getElementById('wheel-result').textContent = 'La roue tourne…';

  const n = WHEEL_SEGMENTS.length;
  const seg = 360/n;
  const targetIndex = pickWeightedSegment();
  // angle pour amener le centre du segment gagnant sous le pointeur (en haut)
  const targetAngle = 360 - (targetIndex*seg + seg/2);
  const extraTurns = 5 + Math.floor(Math.random()*3);
  const finalRotation = wheelRotation - (wheelRotation % 360) + extraTurns*360 + targetAngle;

  const canvas = document.getElementById('wheel-canvas');
  canvas.style.transform = `rotate(${finalRotation}deg)`;
  wheelRotation = finalRotation;

  setTimeout(()=>{
    applyWheelPrize(WHEEL_SEGMENTS[targetIndex]);
    wheelSpinning = false;
    renderWheel();
  }, 4300);
}

function applyWheelPrize(prize){
  let msg = '';
  if(prize.type==='coins'){
    state.coins += prize.amount;
    msg = `🪙 Tu gagnes ${prize.amount} pièces !`;
  } else if(prize.type==='jackpot'){
    state.coins += prize.amount;
    msg = `🎉 JACKPOT ! +${prize.amount} pièces !`;
  } else if(prize.type==='seed'){
    state.seeds[prize.id] = (state.seeds[prize.id]||0)+1;
    msg = `🌱 Tu gagnes une graine : ${seedById(prize.id).name} !`;
  } else if(prize.type==='seedRare'){
    const rarePool = SEEDS.filter(s=>s.rarity==='rare'||s.rarity==='epique');
    const won = rarePool[Math.floor(Math.random()*rarePool.length)];
    state.seeds[won.id] = (state.seeds[won.id]||0)+1;
    msg = `✨ Graine rare gagnée : ${won.name} !`;
  }
  document.getElementById('wheel-result').textContent = msg;
  saveGarden(); renderHUD(); renderHotbar();
}

/* ---- sell shop ---- */
function renderSell(){
  const body = document.getElementById('sell-body');
  const prodIds = Object.keys(state.produce).filter(k=>state.produce[k]>0);
  if(!prodIds.length){
    body.innerHTML = '<div class="empty-note">Ton panier de récolte est vide.<br>Récolte des plantes prêtes dans ton jardin, puis reviens les vendre ici.</div>';
  } else {
    body.innerHTML = prodIds.map(id=>{
      const s = seedById(id);
      const rar = RARITIES[s.rarity];
      const qty = state.produce[id];
      const unit = sellPriceFor(s);
      return `<div class="sell-row">
        <div class="ic" style="background:#${s.leaf.toString(16).padStart(6,'0')};border-color:${rar.color}"></div>
        <div class="info">
          <div class="nm">${s.name} <span style="color:${rar.color}">· ${rar.label}</span></div>
          <div class="sub">x${qty} en stock · 🪙${unit} pièce${eventSellMult()>1?' (bonus lune 🌕)':''}</div>
        </div>
        <div class="qtybtns">
          <button class="one" data-sellone="${id}">Vendre 1</button>
          <button class="all" data-sellall="${id}">Tout (🪙${qty*unit})</button>
        </div>
      </div>`;
    }).join('');
    body.querySelectorAll('[data-sellone]').forEach(btn=> btn.onclick = ()=>sellProduce(btn.dataset.sellone, 1));
    body.querySelectorAll('[data-sellall]').forEach(btn=> btn.onclick = ()=>sellProduce(btn.dataset.sellall, 'all'));
  }
  updateSellTotal();
}

function updateSellTotal(){
  const total = document.getElementById('sell-total');
  const prodIds = Object.keys(state.produce).filter(k=>state.produce[k]>0);
  const grandTotal = prodIds.reduce((sum,id)=> sum + state.produce[id]*sellPriceFor(seedById(id)), 0);
  total.innerHTML = `<div><div class="lbl">Valeur totale du panier</div><div class="val">🪙 ${grandTotal}</div></div>
    <button id="sell-all-btn" ${grandTotal<=0?'disabled':''}>Tout vendre</button>`;
  const btn = document.getElementById('sell-all-btn');
  if(btn) btn.onclick = sellAllProduce;
}

function sellProduce(id, qtyOrAll){
  const s = seedById(id);
  const have = state.produce[id]||0;
  if(have<=0) return;
  const qty = qtyOrAll==='all' ? have : Math.min(qtyOrAll, have);
  if(qty<=0) return;
  state.coins += qty*sellPriceFor(s);
  state.produce[id] = have - qty;
  saveGarden(); renderSell(); renderInventory(); renderHUD();
}
function sellAllProduce(){
  let gained = 0;
  Object.keys(state.produce).forEach(id=>{
    const qty = state.produce[id]||0;
    if(qty>0){ gained += qty*sellPriceFor(seedById(id)); state.produce[id]=0; }
  });
  if(gained>0){ state.coins += gained; saveGarden(); renderSell(); renderInventory(); renderHUD(); }
}

function renderHotbar(){
  const bar = document.getElementById('hotbar');
  const owned = Object.keys(state.seeds).filter(k=>state.seeds[k]>0);
  if(!owned.length){ bar.innerHTML = '<div style="color:#eee;font-size:11px;padding:14px 10px;">sac vide</div>'; return; }
  bar.innerHTML = owned.map(id=>{
    const s = seedById(id);
    return `<div class="hotslot ${selectedSeed===id?'selected':''}" data-seed="${id}">
      <div class="ic" style="background:#${s.leaf.toString(16).padStart(6,'0')}"></div>
      <div class="cnt">${state.seeds[id]}</div></div>`;
  }).join('');
  bar.querySelectorAll('[data-seed]').forEach(el=>{
    el.onclick = ()=>{ selectedSeed = el.dataset.seed; renderHotbar(); };
  });
}

function renderHUD(){
  document.getElementById('coins').textContent = state.coins;
}

function openPanel(id){
  ['panel-shop','panel-inv','panel-sell','panel-wheel','panel-chat'].forEach(p=>{
    document.getElementById(p).classList.toggle('open', p===id);
  });
}
document.querySelectorAll('[data-close]').forEach(b=>{
  b.onclick = ()=> document.getElementById(b.dataset.close).classList.remove('open');
});
document.getElementById('btn-shop').onclick = ()=>{ renderShop(); openPanel('panel-shop'); };
document.getElementById('btn-inv').onclick = ()=>{ renderInventory(); openPanel('panel-inv'); };
document.getElementById('btn-sell').onclick = ()=>{ renderSell(); openPanel('panel-sell'); };
document.getElementById('btn-wheel').onclick = ()=>{ renderWheel(); openPanel('panel-wheel'); };
document.getElementById('btn-chat').onclick = ()=>{ openPanel('panel-chat'); };
document.getElementById('wheel-spin-btn').addEventListener('click', spinWheel);

document.getElementById('chat-form').addEventListener('submit', e=>{
  e.preventDefault();
  const inp = document.getElementById('chat-input');
  const text = inp.value.trim();
  if(!text) return;
  inp.value='';
  pushChat(text);
});

/* =========================================================
   START
========================================================= */
document.getElementById('start-btn').onclick = startGame;
document.getElementById('name-input').addEventListener('keydown', e=>{ if(e.key==='Enter') startGame(); });

document.getElementById('sound-toggle').addEventListener('click', ()=>{
  soundOn = !soundOn;
  document.getElementById('sound-toggle').textContent = soundOn ? '🔊' : '🔇';
  if(soundOn) initAudio();
});

async function startGame(){
  const val = document.getElementById('name-input').value.trim();
  playerName = (val || 'Jardinier'+Math.floor(Math.random()*999)).slice(0,16);
  initAudio();
  document.getElementById('start').style.display='none';
  document.getElementById('hud').style.display='flex';
  document.getElementById('bottombar').style.display='flex';
  document.getElementById('tip').style.display='block';
  setTimeout(()=>document.getElementById('tip').style.display='none', 6000);

  await ensureShopStock();
  await loadGarden();
  await touchPresence();
  await refreshPresence();
  const log = await sGet('chat:log', true) || [];
  renderChat(log);
  pushChat('a rejoint le jardin 🌿');

  renderHUD(); renderHotbar(); renderInventory();
  initScene();
  await pollEvents();

  setInterval(()=>{ saveGarden(); }, 8000);
  setInterval(touchPresence, 15000);
  setInterval(refreshPresence, 10000);
  setInterval(refreshChat, 3500);
  setInterval(async ()=>{ await ensureShopStock(); if(document.getElementById('panel-shop').classList.contains('open')) renderShop(); }, 6000);
  setInterval(renderHUD, 1000);
  setInterval(pollEvents, 15000);
  setInterval(renderEventBanner, 1000);
}
</script>
</body>
</html>
